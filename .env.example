# 大模型，OpenAI 兼容接口（DeepSeek / 通义 / Kimi / 自建网关都可以）。
# 密钥请在网页右上角「密钥设置」里填写，保存在 config/local.json，并覆盖这里的同名项。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 素材库。多个 Key 用英文逗号分隔，限流时自动换下一个。
# 这些密钥也可以在网页右上角「密钥设置」里填写，保存在 config/local.json，并覆盖这里的同名项。
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Freesound。检索时只带 CC0 和 CC BY（可免费商用）。密钥也可在网页「密钥设置」里填写。
FREESOUND_API_KEY=

# 可选文生图，OpenAI images 兼容。超时 15 秒会继续往下兜底
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=dall-e-3

# 本地 Stable Diffusion WebUI（启动时加 --api）。图库失败后用它出图。
# 连不上就退回色块画面。默认 432x768，显存够可以改成 832x1216。
SD_WEBUI_ENABLE=1
SD_WEBUI_URL=http://127.0.0.1:7860
SD_WEBUI_USER=
SD_WEBUI_PASSWORD=
SD_STEPS=20
SD_CFG=7
SD_SAMPLER=Euler a
SD_SCHEDULER=
# 默认锁定 REALISTIC_COMIC_BOOK。留空才按分镜风格自动切换。
SD_MODEL=REALISTIC_COMIC_BOOK
SD_WIDTH=0
SD_HEIGHT=0
SD_TIMEOUT=180
SD_NEGATIVE=((frame, photo, 3D)), poorly drawn hair, squiggles, drawing artefact, child, black and white, sketch, artefact, text, cover, photo of pencil, frame, mutilated, extra fingers, mutated hands, poorly drawn hands, mutation, deformed, blurry, bad anatomy, extra limbs, cloned face, disfigured, malformed limbs, missing arms, missing legs, extra arms, extra legs, fused fingers, too many fingers, watermark, font, text, cropped, out of frame, worst quality, low quality, jpeg artifacts, duplicate, BadDream, UnrealisticDream, close-up, closeup, portrait, headshot, selfie, bust shot, face focus, large face, foreground person

# 配音与字体。字体留空时会自动找系统里的 Noto Sans SC / 黑体
TTS_VOICE=zh-CN-XiaoxiaoNeural
FONT_PATH=
BGM_PATH=

# CLIP 语义过滤，默认关闭。设为 1 且已安装 open_clip_torch 才会启用
CLIP_ENABLE=0
CLIP_THRESHOLD=0.22

CLEANUP_HOURS=24
REQUEST_TIMEOUT=15
FFMPEG_BIN=
FFPROBE_BIN=
